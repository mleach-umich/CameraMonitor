# Optional Docker Compose host-level overrides.
# Copy to .env if you want to override defaults for your machine.
#
# App/runtime config is now split as:
#   - .env.shared        (tracked, non-sensitive)
#   - .env.secret        (local only, sensitive)
# See README for details.

# Host timezone for container runtime logs.
TZ=America/Detroit

# Host path where runtime CSV/chart files are stored.
# Use an absolute path on Linux for resilience across git reset/reclone.
HOST_DATA_DIR=./data

# Optional: run containers as this host user/group to avoid permission issues.
# LOCAL_UID=1002
# LOCAL_GID=1002
