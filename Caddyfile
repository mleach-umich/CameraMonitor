{
    admin off
    auto_https disable_redirects
}

https://localhost:8443 {
    tls internal

    root * /srv

    # Avoid stale images/logs when the monitor updates files.
    header {
        Cache-Control "no-store, no-cache, must-revalidate"
        Pragma "no-cache"
        Expires "0"
    }

    file_server browse
}
